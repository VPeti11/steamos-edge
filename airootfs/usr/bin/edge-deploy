#!/bin/bash
set -e

echo "==== SteamOS Edge Deploy script ===="

if [[ $EUID -ne 0 ]]; then
    echo "This script must be run as root. Use sudo!"
    exit 1
fi

# ===== 1. Ask for parameters =====
read -rp "Target disk (example: /dev/sda): " DISK
if [ ! -b "$DISK" ]; then
    echo "Error: $DISK is not a valid block device."
    exit 1
fi

read -rp "EFI partition size in MiB (default 512): " BOOT_SIZE
BOOT_SIZE=${BOOT_SIZE:-512}

read -rp "Enable UEFI boot? (y/n, default y): " UEFI_INPUT
UEFI_INPUT=${UEFI_INPUT:-y}
UEFI=false
[ "$UEFI_INPUT" = "y" ] && UEFI=true

read -rp "Enable BIOS boot? (y/n, default y): " BIOS_INPUT
BIOS_INPUT=${BIOS_INPUT:-y}
GRUB_BIOS=false
[ "$BIOS_INPUT" = "y" ] && GRUB_BIOS=true

echo ""
echo "Target disk: $DISK"
echo "EFI partition size: $BOOT_SIZE MiB"
echo "UEFI boot: $UEFI"
echo "BIOS boot: $GRUB_BIOS"
echo "WARNING: Everything on $DISK will be erased!"
read -rp "Press Enter to continue or Ctrl+C to cancel..."

# ===== 2. Partition disk =====
echo "Partitioning $DISK..."
sgdisk --zap-all "$DISK"
if $UEFI; then
    sgdisk -n 1:0:+${BOOT_SIZE}M -t 1:ef00 -c 1:"EFI System" "$DISK"
    sgdisk -n 2:0:0 -t 2:8300 -c 2:"Linux Root" "$DISK"
else
    sgdisk -n 1:0:0 -t 1:8300 -c 1:"Linux Root" "$DISK"
fi

BOOT_PART="${DISK}1"
ROOT_PART="${DISK}2"

# ===== 3. Format partitions =====
echo "Formatting partitions..."
if $UEFI; then
    mkfs.fat -F32 "$BOOT_PART"
fi
mkfs.ext4 "$ROOT_PART"

# ===== 4. Mount partitions =====
echo "Mounting partitions..."
mount "$ROOT_PART" /mnt
if $UEFI; then
    mkdir -p /mnt/boot
    mount "$BOOT_PART" /mnt/boot
fi

# ===== 5. Copy live ISO root =====
echo "Copying live ISO root filesystem..."

SRC="/run/archiso/airootfs"
DST="/mnt"

RSYNC_OPTS='-aHAX --links --numeric-ids --info=progress2 --one-file-system'
EXCLUDES='--exclude={"/dev/*","/proc/*","/sys/*","/tmp/*","/run/*","/var/run/*","/var/lock/*","/var/tmp/*","/var/mnt/*","/mnt/*","/media/*","/lost+found","/swapfile"}'

# Create required directories
mkdir -p "$DST/boot" "$DST/EFI"
mkdir -p "$DST/usr/bin" "$DST/usr/sbin" "$DST/usr/lib" "$DST/usr/lib64" "$DST/usr/share"
mkdir -p "$DST/bin" "$DST/sbin" "$DST/lib" "$DST/lib64"
mkdir -p "$DST/etc" "$DST/opt" "$DST/root" "$DST/home" "$DST/var"

# Copy /boot
rsync $RSYNC_OPTS $EXCLUDES "$SRC/boot/" "$DST/boot/"

# Copy EFI (static subfolders only)
mkdir -p "$DST/boot/EFI"
cp -a "$SRC/EFI/BOOT" "$DST/boot/EFI/" || true
cp -a "$SRC/EFI/archiso" "$DST/boot/EFI/" || true

# Copy /usr (essential, minimal)
rsync $RSYNC_OPTS $EXCLUDES --exclude={"/usr/share/doc/*","/usr/share/man/*","/usr/share/info/*","/usr/share/locale/*"} "$SRC/usr/bin/"  "$DST/usr/bin/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/usr/sbin/"  "$DST/usr/sbin/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/usr/lib/"    "$DST/usr/lib/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/usr/lib64/"  "$DST/usr/lib64/"
rsync $RSYNC_OPTS $EXCLUDES --exclude={"doc","man","info","locale"} "$SRC/usr/share/" "$DST/usr/share/"

# Copy /bin /sbin /lib /lib64
rsync $RSYNC_OPTS $EXCLUDES "$SRC/bin/"   "$DST/bin/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/sbin/"  "$DST/sbin/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/lib/"   "$DST/lib/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/lib64/" "$DST/lib64/" || true

# Copy /etc /opt /root /home
rsync $RSYNC_OPTS $EXCLUDES "$SRC/etc/"   "$DST/etc/"
rsync $RSYNC_OPTS $EXCLUDES "$SRC/opt/"   "$DST/opt/" || true
rsync $RSYNC_OPTS $EXCLUDES "$SRC/root/"  "$DST/root/" || true
rsync $RSYNC_OPTS $EXCLUDES "$SRC/home/"  "$DST/home/" || true

# Copy /var (minimal)
VAR_EXCLUDES='--exclude={"/var/cache/*","/var/log/*","/var/tmp/*","/var/run/*","/var/lock/*"}'
rsync $RSYNC_OPTS $EXCLUDES $VAR_EXCLUDES "$SRC/var/" "$DST/var/"

echo "Rsync copy finished."

# ===== 6. Copy GRUB and EFI from live ISO/CD =====
echo "Copying GRUB and EFI files from live ISO/CD..."
if $UEFI || $GRUB_BIOS; then
    # Create target directories
    mkdir -p /mnt/boot/grub
    mkdir -p /mnt/boot/EFI

    # Copy GRUB modules (BIOS)
    cp -a /run/archiso/bootmnt/boot/grub/* /mnt/boot/grub/ 2>/dev/null || true

    # Copy EFI files (UEFI)
    cp -a /run/archiso/bootmnt/EFI/BOOT /mnt/boot/EFI/ 2>/dev/null || true
    cp -a /run/archiso/bootmnt/EFI/archiso /mnt/boot/EFI/ 2>/dev/null || true
fi

# ===== 7. Install bootloader based on partition choice =====
echo "Setting up mountpoints and installing GRUB bootloader..."

# Makesure required directories exist in the target for chroot
mkdir -p /mnt/proc /mnt/sys /mnt/dev /mnt/dev/pts /mnt/run /mnt/tmp
chmod 1777 /mnt/tmp
mkdir -p /mnt/var/run /mnt/var/lock

# Bind mount necessary filesystems
mount --bind /dev  /mnt/dev
mount --bind /dev/pts /mnt/dev/pts
mount --bind /proc /mnt/proc
mount --bind /sys  /mnt/sys
mount --bind /run  /mnt/run

# Determine PART_CHOICE for logic
if $UEFI && ! $GRUB_BIOS; then
    PART_CHOICE=1
elif ! $UEFI && $GRUB_BIOS; then
    PART_CHOICE=2
else
    PART_CHOICE=3
fi

# Install GRUB inside chroot based on PART_CHOICE
if [[ "$PART_CHOICE" == "1" ]]; then
  arch-chroot /mnt /usr/bin/grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --recheck --no-nvram || \
    arch-chroot /mnt /usr/bin/grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --removable --recheck || \
    echo "grub-install (UEFI) may have failed; inspect chroot."
  arch-chroot /mnt /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg || echo "grub-mkconfig failed."

elif [[ "$PART_CHOICE" == "2" ]]; then
  arch-chroot /mnt /usr/bin/grub-install --target=i386-pc --recheck "$DISK" || echo "grub-install (BIOS) failed."
  arch-chroot /mnt /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg || echo "grub-mkconfig failed."

else
  arch-chroot /mnt /usr/bin/grub-install --target=i386-pc --recheck "$DISK" || echo "grub-install (BIOS) failed."
  arch-chroot /mnt /usr/bin/grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --recheck --no-nvram || \
    arch-chroot /mnt /usr/bin/grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --removable --recheck || \
    echo "grub-install (UEFI) may have failed."
  arch-chroot /mnt /usr/bin/grub-mkconfig -o /boot/grub/grub.cfg || echo "grub-mkconfig failed."
fi

# Unmount bind mounts
umount -R /mnt/dev/pts
umount -R /mnt/dev
umount -R /mnt/proc
umount -R /mnt/sys
umount -R /mnt/run

echo "GRUB installation complete."

# ===== 8. Cleanup =====
echo "Unmounting..."
umount -R /mnt

echo "SteamOS Edge cloned to disk"
